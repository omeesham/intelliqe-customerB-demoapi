# --- Required ---
# Base URL of the application under test.
# In GitHub Actions this comes from the BASE_URL repository secret.
BASE_URL=https://app.example.com

# --- Credentials ---
# Used by tests that sign in. In CI these come from GitHub Actions secrets
# (Settings -> Secrets and variables -> Actions): APP_USERNAME, APP_PASSWORD.
APP_USERNAME=
APP_PASSWORD=

# --- Database validation (optional) ---
# Tests can assert on the application's Azure SQL database via common/db.ts.
# In CI these values come from GitHub Actions secrets. Leave blank if your tests
# do not touch the database.
# Provide discrete fields...
DB_SERVER=your-server.database.windows.net
DB_DATABASE=your-database
DB_USER=your-username
DB_PASSWORD=
DB_PORT=1433
# Encryption is ON by default (required by Azure SQL); set false only for local.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false
# ...or a single connection string, which takes precedence over the fields above.
# DB_CONNECTION_STRING=

# --- Optional (safe defaults) ---
# Run browsers headless (true/false).
HEADLESS=true
# Parallel worker count.
WORKERS=4
# Per-test timeout in milliseconds.
TIMEOUT=30000
# Set to true in CI to enable retries and forbid .only.
CI=false
